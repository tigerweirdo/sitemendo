# Derleme (next build). Boş kalırsa bu varsayılanlar kullanılır.
NEXT_PUBLIC_PRIVACY_URL=/privacy
NEXT_PUBLIC_IMPRESSUM_URL=/impressum

# Worker (form). Canlıda Cloudflare: Worker > Settings > Variables and Secrets (Secret olarak).
# Yerelde npm run preview: .dev.vars dosyasına yazın.
RESEND_API_KEY=
AUDIT_FROM_EMAIL=Sitemendo <hello@sitemendo.com>
AUDIT_NOTIFY_EMAIL=you@gmail.com
# Yalnız yerelde: anahtar yokken form "demo" sonucunu gösterir.
AUDIT_DEMO_MODE=true
