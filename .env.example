# Derleme (next build). Boş kalırsa bu varsayılanlar kullanılır.
NEXT_PUBLIC_PRIVACY_URL=/privacy
NEXT_PUBLIC_IMPRESSUM_URL=/impressum

# Worker (form). Canlıda Cloudflare: Worker > Settings > Variables and Secrets (Secret olarak).
# Yerelde npm run preview: .dev.vars dosyasına yazın.
RESEND_API_KEY=
AUDIT_FROM_EMAIL=Sitemendo <hello@sitemendo.com>
AUDIT_NOTIFY_EMAIL=you@gmail.com
# Yalnız yerelde: anahtar yokken form "demo" sonucunu gösterir.
AUDIT_DEMO_MODE=true

# Ücretsiz kontrol raporu (Workflow, worker/report.ts). Canlıda hepsi Secret.
# Google PageSpeed Insights API anahtarı. Yoksa hız ölçümü "ölçülemedi" olur (anahtarsız kota dolu).
PSI_API_KEY=
# Onay bağlantısının imzası: uzun, rastgele bir metin (ör. openssl rand -hex 32). Yoksa rapor kendiliğinden gitmez.
REPORT_APPROVAL_SECRET=
# Boş = önce sana gelir, onay bağlantısıyla müşteriye gider. "customer" = doğrudan müşteriye, sana gizli kopya.
REPORT_SEND_MODE=
