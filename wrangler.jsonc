{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sitemendo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    // Hash'li Next dosyaları doğrudan gelir (Worker çalışmaz, ücretsiz ve sınırsız);
    // sayfalar, form ve diğer her istek Worker'dan geçer.
    "run_worker_first": ["/*", "!/_next/static/*"]
  },
  "observability": { "enabled": true },
  // Ücretsiz kontrol raporu: form gönderilince bu Workflow çalışır (worker/report.ts).
  // Gerekli secret'lar: RESEND_API_KEY, PSI_API_KEY, REPORT_APPROVAL_SECRET (README).
  "workflows": [{ "name": "sitemendo-report", "binding": "REPORT_WORKFLOW", "class_name": "ReportWorkflow" }]
}
